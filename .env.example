# dbx 内部使用的单一 MCP token，只在 compose 内部传递给 dbx 和网关，不要发给客户端。
# 生成方式：docker compose --project-directory . -f plugins/mcp-token-gateway/docker-compose.mcp-gateway.yml run --rm mcp-gateway node bin/dbx-mcp-token-gateway.mjs secret
DBX_MCP_INTERNAL_TOKEN=replace-with-a-long-random-secret

# dbx 设置了 DBX_PUBLIC_BASE_PATH 时需保持一致，用于拼接 /api/auth/check。
DBX_PUBLIC_BASE_PATH=/

# 可选：Web UI 中“打开 dbx Web 登录页”的链接（浏览器可访问的地址）。
MCP_GATEWAY_DBX_WEB_URL=http://localhost:4224

# 宿主机对外端口；容器内 MCP / Web UI / 管理 API 统一使用 4225，不再有 4226。
MCP_GATEWAY_PUBLIC_PORT=4225

# 浏览器客户端需要设置精确 Origin；留空表示不限制（网关会回显 Origin）。
MCP_GATEWAY_ALLOWED_ORIGINS=

# 当 dbx 设置了 DBX_PUBLIC_BASE_PATH=/dbx 时，这里也要设为 /dbx/mcp。
MCP_GATEWAY_UPSTREAM_MCP_PATH=/mcp

# 可选：是否信任前置反向代理传来的 X-Forwarded-For / X-Real-IP 作为审计中的客户端 IP。
# Docker 端口映射下网关只能看到网桥网关 IP；要记录真实 IP 需在网关前加反向代理并设为 1。
# 无可信代理时保持 0，避免客户端伪造来源。
MCP_GATEWAY_TRUST_PROXY=0
