# 环境变量配置模板。复制为 gateway.env 后填写，dbx 与网关服务共用本文件。

# dbx 与网关之间的内部通信令牌。两行必须填写相同的随机值，请勿下发给客户端。
# 生成随机值：openssl rand -hex 32
DBX_WEB_MCP_TOKEN=replace-with-a-long-random-secret
MCP_GATEWAY_UPSTREAM_TOKEN=replace-with-a-long-random-secret

# 可选：浏览器访问 dbx Web 的地址，用于管理界面的登录入口。
# 例如：http://<NAS-IP>:8082
MCP_GATEWAY_DBX_WEB_URL=

# 可选：精确 Origin 白名单，留空表示不限制。
MCP_GATEWAY_ALLOWED_ORIGINS=

# 仅在使用可信反向代理时开启，用于记录真实客户端 IP；未使用代理时请保持关闭。
MCP_GATEWAY_TRUST_PROXY=0
