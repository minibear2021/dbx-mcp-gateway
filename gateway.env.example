# 复制为 gateway.env 后填写。dbx 与 mcp-gateway 两个服务共用本文件。
# 在 File Station 里把 gateway.env.example 复制一份并改名为 gateway.env 即可，
# 这个文件不是隐藏文件，也不需要做 compose 变量插值。

# dbx 与网关之间共用的内部 token。两行必须填【同一个随机值】，不要发给客户端。
# 生成方式（在 NAS 的 SSH 里任选其一）：
#   openssl rand -hex 32
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DBX_WEB_MCP_TOKEN=replace-with-a-long-random-secret
MCP_GATEWAY_UPSTREAM_TOKEN=replace-with-a-long-random-secret

# 浏览器可访问的 dbx Web 地址，用于 Web UI 中的登录入口链接。
# 例如 NAS IP 是 192.168.1.10：http://192.168.1.10:8082
MCP_GATEWAY_DBX_WEB_URL=http://10.1.4.118:8082

# 可选：精确 Origin 白名单，留空表示不限制。
MCP_GATEWAY_ALLOWED_ORIGINS=
