# dbx 与网关之间共用的内部 token，不要发给客户端。
# 生成方式（任选其一）：
#   openssl rand -hex 32
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DBX_MCP_INTERNAL_TOKEN=replace-with-a-long-random-secret

# 宿主机映射端口；容器内 MCP / Web UI / 管理 API 统一 4225。
MCP_GATEWAY_PUBLIC_PORT=4225

# 可选：浏览器访问 dbx Web 的地址，用于 Web UI 里的登录入口链接。
# 例如 NAS IP 是 192.168.1.10：http://192.168.1.10:8082
DBX_WEB_URL=

# 可选：精确 Origin 白名单，留空表示不限制。
MCP_GATEWAY_ALLOWED_ORIGINS=
